<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Robur Health</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>RoburCloudSyncEnabled</key>
  <true/>
  <key>RoburCloudSyncOrigin</key>
  <string>https://robur-health-ydne76eqcq-nw.a.run.app</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>NSHealthUpdateUsageDescription</key>
  <string>Robur saves workouts you choose to record to Apple Health, where they are available in Fitness. Your existing workouts and effort ratings are preserved.</string>
  <key>NSHealthShareUsageDescription</key>
  <string>Robur reads workouts and Apple Fitness effort, heart rate, sleep, activity, steps, exercise and stand minutes, cardio fitness, weight, height, body composition and approved Health characteristics to calculate recovery, training load and fitness trends. Data stays on this device unless you separately enable web sync and choose what to upload.</string>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>NSMotionUsageDescription</key>
  <string>If you enable suggestions, Robur recognizes sustained running or cycling while open and asks whether you want to start a workout.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Robur checks busy times to suggest training slots and adds or updates your reviewed training placeholders in a calendar you choose.</string>
  <key>NSRemindersFullAccessUsageDescription</key>
  <string>If enabled, Robur adds reminders for confirmed training plans to a list you choose and keeps their times and completion in sync.</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.eojgroup.robur.plan</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>robur</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
