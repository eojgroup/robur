default_platform(:ios)

platform :ios do
  desc "Generate the Xcode project and build without uploading"
  lane :build do
    generate_project
    build_app(
      project: "Robur.xcodeproj",
      scheme: "Robur",
      clean: true,
      skip_package_ipa: true,
      skip_archive: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Archive Robur for iOS, iPadOS, and watchOS, then upload to TestFlight"
  lane :beta do
    api_key = connect_api_key

    generate_project
    setup_ci if ENV["CI"]
    sync_code_signing(
      type: "appstore",
      readonly: ENV["CI"] == "true",
      app_identifier: ["com.eojgroup.robur", "com.eojgroup.robur.watchkitapp"],
      api_key: api_key
    )
    build_app(
      project: "Robur.xcodeproj",
      scheme: "Robur",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Robur.ipa"
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Robur.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  private_lane :generate_project do
    sh("xcodegen generate --spec project.yml")
  end

  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
      in_house: false
    )
  end
end
