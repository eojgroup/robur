# Set this only when the operator has Billing Account Costs Manager or Budget Manager access.
# A budget sends alerts; it does not enforce a hard spending ceiling.
billing_account_id   = "000000-000000-000000"
budget_currency      = "SEK"
monthly_budget_units = 100
